venv/
env/

# Python
__pycache__/
*.pyc
*.pyo

# Environment Variables
.env

# IDE
.vscode/
.idea/

# OS Files
.DS_Store
Thumbs.db

# Generated Files
*.zip

# Temporary Files
temp/
uploads/

